[global]
	width = (0, 500)
	height = (0, 1000)
    timeout = 2
    font = Monospace 10
    frame_width = 0
    separator_height = 10

[urgency_low]
    background = "#1e2021"
    foreground = "#ffffff"

[urgency_normal]
    background = "#1e2021"
    foreground = "#ffffff"

[urgency_critical]
    background = "#FF0000"
    foreground = "#ffffff"
    timeout = 0